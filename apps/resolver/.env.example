# ID Resolver V1 environment template (resolver service).
#
# Local development only: copy to .env (git-ignored) and fill in the secrets.
#   cp .env.example .env
#   node --env-file=.env dist/main.js
# Railway deployments do NOT read this file. Set each variable on the Railway
# service as a (sealed, for secrets) variable. Every value below is a
# placeholder; never commit a real value, client name or hostname.
#
# Every variable below matches src/config/index.ts (name, default, bounds).
# Comments sit on their own lines because Node's --env-file parser does not
# strip trailing comments from values.
# Do not set a variable to an empty string: an empty value fails validation for
# numeric and enum variables. Delete the line to use the default.
# Removed variables (MAX_CONCURRENT_CHILDREN, CHILD_HARD_KILL_GRACE_MS,
# RUN_MIGRATIONS_ON_START) are refused at startup: delete them.
# Runtime model, controls and exit codes: RUNTIME.md.
#
# Secrets below are placeholders. Generate real values with:
#   openssl rand -hex 32

# ---- Runtime ---------------------------------------------------------------
# NODE_ENV: production | development | test (default production)
NODE_ENV=production
# PORT: 1-65535 (default 8080)
PORT=8080
# HOST: bind address (default 0.0.0.0)
HOST=0.0.0.0
# LOG_LEVEL: fatal | error | warn | info | debug (default info)
LOG_LEVEL=info

# ---- Identity (per client; unique per deployment; no default) --------------
# INSTALLATION_ID: lowercase letters, digits, hyphens; 1-63 chars; required
INSTALLATION_ID=local-dev
# WEBSITE_ID: same rules; must equal the website_id sent in requests; required
WEBSITE_ID=local-dev

# ---- Secrets (never logged; no default) ------------------------------------
# RESOLVER_AUTH_TOKEN: 32-256 chars; required; the website's bearer token
RESOLVER_AUTH_TOKEN=replace-with-64-hex-chars-from-openssl-rand
# IP_HMAC_SECRET: 32-512 chars; required; keys the IP fingerprint
IP_HMAC_SECRET=replace-with-64-hex-chars-from-openssl-rand
# IP_HMAC_KEY_VERSION: 1-1000000 (default 1); bump when IP_HMAC_SECRET is rotated
IP_HMAC_KEY_VERSION=1
# ENRICH_API_KEY: max 512 chars (default empty); must be 8+ chars when PROVIDER_MODE=live
ENRICH_API_KEY=
# REPORTING_AUTH_TOKEN: 32-256 chars (default unset = reporting routes do not exist); the Insights project's read-only bearer token; must differ from RESOLVER_AUTH_TOKEN
# REPORTING_AUTH_TOKEN=replace-with-64-hex-chars-from-openssl-rand
# DATABASE_URL: required; max 2048 chars. The resolver's own PostgreSQL only: a Supabase host
# (supabase.co, supabase.in, supabase.com) is refused, and so is any SUPABASE_* variable
# (docs/GUARDRAILS.md G3a). It must name its host (postgres:///db is refused: node-postgres would
# take the host from PGHOST); PGHOST/PGHOSTADDR on a Supabase host are refused too.
DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL: require | verify-pinned | no-verify | disable (default require). Applies to the
# service, migrate and every ops command. See RUNTIME.md "Database TLS".
#   verify-pinned: the server's leaf certificate must match DATABASE_TLS_PIN_SHA256 (Railway template)
#   require:       chain to the system CAs (or DATABASE_CA_CERT) and the host name
#   no-verify:     refused when NODE_ENV=production unless ALLOW_UNVERIFIED_DATABASE_TLS=true
#   disable:       always refused when NODE_ENV=production (local development only)
DATABASE_SSL=require
# DATABASE_TLS_PIN_SHA256: verify-pinned only; 64 hex digits (colons allowed), or "current,next"
# during a rotation. Discover it with: node dist/ops/db-tls-fingerprint.js
# DATABASE_TLS_PIN_SHA256=
# DATABASE_CA_CERT: optional PEM bundle (not a secret): trust anchors for require, an additional
# chain and validity check for verify-pinned. A one-line value with literal \n is accepted.
# DATABASE_CA_CERT=
# ALLOW_UNVERIFIED_DATABASE_TLS: true | false (default false); dev-only override that lets
# DATABASE_SSL=no-verify start when NODE_ENV=production (logged as a warning on every start)
ALLOW_UNVERIFIED_DATABASE_TLS=false
# Database roles (RUNTIME.md "Database roles"). DATABASE_URL is the OWNER: migrate and the ops
# commands use it. The service logs in as the runtime role, which migrate creates and grants.
# DATABASE_RUNTIME_ROLE: lowercase identifier, not pg_* (default idr_runtime); must differ from
# the DATABASE_URL user
# DATABASE_RUNTIME_ROLE=idr_runtime
# DATABASE_RUNTIME_PASSWORD: SECRET; 32-256 printable ASCII characters without '%'
# (openssl rand -hex 32). Set = role separation on (migrate sets it, the service logs in with it).
# Required when NODE_ENV=production unless ALLOW_OWNER_DATABASE_ROLE=true.
# DATABASE_RUNTIME_PASSWORD=replace-with-64-hex-chars-from-openssl-rand
# ALLOW_OWNER_DATABASE_ROLE: true | false (default false); dev-only override that lets the
# service run as the DATABASE_URL owner when NODE_ENV=production (logged on every start)
ALLOW_OWNER_DATABASE_ROLE=false

# Local-dev database values (comments only; never used in Railway). Plaintext needs
# NODE_ENV=development (or test): production refuses DATABASE_SSL=disable.
#   local development:  NODE_ENV=development
#                       DATABASE_URL=postgres://idr_dev:idr_dev_local_only@localhost:5432/id_resolver_dev
#                       DATABASE_SSL=disable
#   local test suites:  DATABASE_URL=postgres://idr_test:idr_test_local_only@localhost:5432/id_resolver_test
#                       DATABASE_SSL=disable

# ---- Provider (Enrich) ------------------------------------------------------
# PROVIDER_MODE: live | mock | disabled (default disabled); keep disabled until verified
PROVIDER_MODE=disabled
# ALLOW_MOCK_PROVIDER: true | false (default false); PROVIDER_MODE=mock is refused when
# NODE_ENV=production unless this is true (the isolated development deployment only)
ALLOW_MOCK_PROVIDER=false
# ENRICH_API_BASE_URL: URL, max 512 chars (default https://dev.enrich.so/api/v3); confirm before live.
# A Supabase host is refused (docs/GUARDRAILS.md G3a).
ENRICH_API_BASE_URL=https://dev.enrich.so/api/v3
# ENRICH_AUTH_HEADER: x-api-key | authorization-bearer (default x-api-key)
ENRICH_AUTH_HEADER=x-api-key
# ENRICH_TIMEOUT_MS: 200-10000 (default 2500); must be below REQUEST_DEADLINE_MS
ENRICH_TIMEOUT_MS=2500

# ---- Request handling (single-process runtime; see RUNTIME.md) ---------------
# REQUEST_DEADLINE_MS: 300-15000 (default 4000); the caller is always answered by then
REQUEST_DEADLINE_MS=4000
# MAX_CONCURRENT_JOBS: 1-64 (default 8); resolution jobs executing at once in this process;
# one more is refused with 503 overloaded and /readyz reports not ready
MAX_CONCURRENT_JOBS=8
# EVENT_LOOP_BLOCK_EXIT_MS: 1000-60000 (default 10000); the watchdog kills the process when its
# event loop has been blocked longer than this (the platform restarts it)
EVENT_LOOP_BLOCK_EXIT_MS=10000
# AUTH_FAILURE_LIMIT_PER_MINUTE: unauthenticated/malformed-credential requests allowed per peer address per minute (1-100000, default 60).
# AUTH_FAILURE_LIMIT_PER_MINUTE=60

# RATE_LIMIT_PER_MINUTE: 1-100000 (default 600); per deployment
RATE_LIMIT_PER_MINUTE=600
# BODY_LIMIT_BYTES: 128-8192 (default 1024)
BODY_LIMIT_BYTES=1024
# SHUTDOWN_GRACE_MS: 500-30000 (default 8000); at least REQUEST_DEADLINE_MS + 500; in-flight jobs drain within it
SHUTDOWN_GRACE_MS=8000

# ---- Enrichment controls ----------------------------------------------------
# ENRICHMENT_ENABLED: true | false | 1 | 0 (default true); false is the config kill switch (redeploys)
ENRICHMENT_ENABLED=true
# PERIOD_CALL_CAP: 0-10000000 (default 1000); provider calls allowed per usage period, charged or not; 0 = none
PERIOD_CALL_CAP=1000
# PERIOD_RESOLVED_CAP: 0-10000000 (optional; unset = PERIOD_CALL_CAP); provider calls per usage period that may be
# charged. Each call holds a slot until its answer proves no charge (no domain, 401/403, 402, 429). Enrich charges
# only for a returned domain, so with USAGE_PERIOD=day this pauses lookups for the rest of the day after this many
# charged (or possibly charged) calls, while calls that find nothing keep going up to PERIOD_CALL_CAP.
# PERIOD_RESOLVED_CAP=50
# USAGE_PERIOD: day | month (default month)
USAGE_PERIOD=month

# ---- Cache policy (seconds) -------------------------------------------------
# TTL_QUALIFIED_S: 60-7776000 (default 604800 = 7 days)
TTL_QUALIFIED_S=604800
# TTL_NO_MATCH_S: 60-2592000 (default 86400 = 24 h)
TTL_NO_MATCH_S=86400
# TTL_EXCLUDED_S: 60-7776000 (default 604800 = 7 days)
TTL_EXCLUDED_S=604800
# TTL_UNKNOWN_S: 60-2592000 (default 86400 = 24 h)
TTL_UNKNOWN_S=86400
# TTL_PROVIDER_ERROR_S: 10-86400 (default 600 = 10 min backoff)
TTL_PROVIDER_ERROR_S=600
# TTL_UNCERTAIN_S: 60-604800 (default 3600 = 60 min suppression after a provider timeout)
TTL_UNCERTAIN_S=3600
# LEASE_MS: 500-60000 (default 6000); must exceed ENRICH_TIMEOUT_MS
LEASE_MS=6000
# PENDING_WAIT_MS: 0-10000 (default 1500); how long a caller waits on an in-flight lookup
PENDING_WAIT_MS=1500
# PENDING_POLL_MS: 10-1000 (default 75)
PENDING_POLL_MS=75
# Maintenance run: deletes expired cache rows and observations past
# OBSERVATION_RETENTION_DAYS. It runs once at startup, then every interval, and
# drains in batches until a batch comes back short or the budget is spent
# (expired cache rows may use half the budget). A run that leaves rows due logs
# the warning maintenance_backlog; if that repeats, raise the batch or budget.
# CACHE_PRUNE_INTERVAL_S: 30-86400 (default 600)
CACHE_PRUNE_INTERVAL_S=600
# CACHE_PRUNE_BATCH: 10-100000 (default 1000); rows deleted per statement
CACHE_PRUNE_BATCH=1000
# CACHE_PRUNE_BUDGET_MS: 1000-300000 (default 20000); time budget of one run, below the interval
CACHE_PRUNE_BUDGET_MS=20000
# OBSERVATION_RETENTION_DAYS: REQUIRED, whole days 1-365, NO DEFAULT (owner decision D3).
# A bounded synchronisation buffer, not commercial history (the client's Insights
# environment owns that). It must EXCEED THE LONGEST INSIGHTS SYNC OUTAGE YOU WILL
# TOLERATE: older observations are pruned whether or not Insights has pulled them.
# Shorter is better for privacy. The service refuses to start until you set it.
# Companies and per-company scope stats are never pruned. See RUNTIME.md.
# OBSERVATION_RETENTION_DAYS=

# ---- Browser events (contract event.v1, CHR-64; owner decision D4) ---------
# Optional consent-gated browser events relayed by the website server. They are
# stored in browser_events only and are NEVER associated with companies; no IP
# or identifier is accepted or stored. Pruned with OBSERVATION_RETENTION_DAYS.
# EVENTS_ENABLED: true | false | 1 | 0 (default false); when false POST /v1/events
# does not exist and answers 404 like any unknown route
EVENTS_ENABLED=false
# EVENT_CONSENT_MODE: required | not_required (default required); under required an
# event whose consent is not_required is refused with 403 consent_required
EVENT_CONSENT_MODE=required

# ---- Qualification policy (comma-separated; whitespace is trimmed) ----------
# QUALIFIED_USAGE_TYPES: default COM,ORG,GOV,EDU,MIL,LIB
QUALIFIED_USAGE_TYPES=COM,ORG,GOV,EDU,MIL,LIB
# EXCLUDED_USAGE_TYPES: default ISP,MOB,DCH,CDN,SES,RSV
EXCLUDED_USAGE_TYPES=ISP,MOB,DCH,CDN,SES,RSV
# DENIED_DOMAINS: default empty (leave the line out or set it to domains that always resolve to unknown)
DENIED_DOMAINS=

# ---- Migrations ---------------------------------------------------------------
# Migrations run ONLY as a deploy pre-step (railway.json preDeployCommand:
# `node dist/db/migrate.js`) or locally with `npm run migrate`. The service never
# migrates on start and refuses to start while this build has pending migrations.
