# ID Resolver V1 environment template (resolver service).
#
# Local development only: copy to .env (git-ignored) and fill in the secrets.
#   cp .env.example .env
#   node --env-file=.env dist/supervisor/main.js
# Railway deployments do NOT read this file. Set each variable on the Railway
# service as a (sealed, for secrets) variable. Every value below is a
# placeholder; never commit a real value, client name or hostname.
#
# Every variable below matches src/config/index.ts (name, default, bounds).
# Comments sit on their own lines because Node's --env-file parser does not
# strip trailing comments from values.
# Do not set a variable to an empty string: an empty value fails validation for
# numeric and enum variables. Delete the line to use the default.
#
# Secrets below are placeholders. Generate real values with:
#   openssl rand -hex 32

# ---- Runtime ---------------------------------------------------------------
# NODE_ENV: production | development | test (default production)
NODE_ENV=production
# PORT: 1-65535 (default 8080)
PORT=8080
# HOST: bind address (default 0.0.0.0)
HOST=0.0.0.0
# LOG_LEVEL: fatal | error | warn | info | debug (default info)
LOG_LEVEL=info

# ---- Identity (per client; unique per deployment; no default) --------------
# INSTALLATION_ID: lowercase letters, digits, hyphens; 1-63 chars; required
INSTALLATION_ID=local-dev
# WEBSITE_ID: same rules; must equal the website_id sent in requests; required
WEBSITE_ID=local-dev

# ---- Secrets (never logged; no default) ------------------------------------
# RESOLVER_AUTH_TOKEN: 32-256 chars; required; the website's bearer token
RESOLVER_AUTH_TOKEN=replace-with-64-hex-chars-from-openssl-rand
# IP_HMAC_SECRET: 32-512 chars; required; keys the IP fingerprint
IP_HMAC_SECRET=replace-with-64-hex-chars-from-openssl-rand
# IP_HMAC_KEY_VERSION: 1-1000000 (default 1); bump when IP_HMAC_SECRET is rotated
IP_HMAC_KEY_VERSION=1
# ENRICH_API_KEY: max 512 chars (default empty); must be 8+ chars when PROVIDER_MODE=live
ENRICH_API_KEY=
# REPORTING_AUTH_TOKEN: 32-256 chars (default unset = reporting routes do not exist); the Insights project's read-only bearer token; must differ from RESOLVER_AUTH_TOKEN
# REPORTING_AUTH_TOKEN=replace-with-64-hex-chars-from-openssl-rand
# DATABASE_URL: required; max 2048 chars
DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL: require | disable | no-verify (default require); use require (or no-verify only for a private-network database)
DATABASE_SSL=require

# Local-dev database values (comments only; never used in Railway):
#   local development:  DATABASE_URL=postgres://idr_dev:idr_dev_local_only@localhost:5432/id_resolver_dev
#                       DATABASE_SSL=disable
#   local test suites:  DATABASE_URL=postgres://idr_test:idr_test_local_only@localhost:5432/id_resolver_test
#                       DATABASE_SSL=disable

# ---- Provider (Enrich) ------------------------------------------------------
# PROVIDER_MODE: live | mock | disabled (default disabled); keep disabled until verified
PROVIDER_MODE=disabled
# ENRICH_API_BASE_URL: URL, max 512 chars (default https://dev.enrich.so/api/v3); confirm before live
ENRICH_API_BASE_URL=https://dev.enrich.so/api/v3
# ENRICH_AUTH_HEADER: x-api-key | authorization-bearer (default x-api-key)
ENRICH_AUTH_HEADER=x-api-key
# ENRICH_TIMEOUT_MS: 200-10000 (default 2500); must be below REQUEST_DEADLINE_MS
ENRICH_TIMEOUT_MS=2500

# ---- Request handling -------------------------------------------------------
# REQUEST_DEADLINE_MS: 300-15000 (default 4000)
REQUEST_DEADLINE_MS=4000
# CHILD_HARD_KILL_GRACE_MS: 100-10000 (default 1000); hard-kill grace after the deadline
CHILD_HARD_KILL_GRACE_MS=1000
# MAX_CONCURRENT_CHILDREN: 1-64 (default 8); per instance
MAX_CONCURRENT_CHILDREN=8
# AUTH_FAILURE_LIMIT_PER_MINUTE: unauthenticated/malformed-credential requests allowed per peer address per minute (1-100000, default 60).
# AUTH_FAILURE_LIMIT_PER_MINUTE=60

# RATE_LIMIT_PER_MINUTE: 1-100000 (default 600); per deployment
RATE_LIMIT_PER_MINUTE=600
# BODY_LIMIT_BYTES: 128-8192 (default 1024)
BODY_LIMIT_BYTES=1024
# SHUTDOWN_GRACE_MS: 500-30000 (default 8000)
SHUTDOWN_GRACE_MS=8000

# ---- Enrichment controls ----------------------------------------------------
# ENRICHMENT_ENABLED: true | false | 1 | 0 (default true); false is the config kill switch (redeploys)
ENRICHMENT_ENABLED=true
# PERIOD_CALL_CAP: 0-10000000 (default 1000); paid calls allowed per usage period; 0 = none
PERIOD_CALL_CAP=1000
# USAGE_PERIOD: day | month (default month)
USAGE_PERIOD=month

# ---- Cache policy (seconds) -------------------------------------------------
# TTL_QUALIFIED_S: 60-7776000 (default 604800 = 7 days)
TTL_QUALIFIED_S=604800
# TTL_NO_MATCH_S: 60-2592000 (default 86400 = 24 h)
TTL_NO_MATCH_S=86400
# TTL_EXCLUDED_S: 60-7776000 (default 604800 = 7 days)
TTL_EXCLUDED_S=604800
# TTL_UNKNOWN_S: 60-2592000 (default 86400 = 24 h)
TTL_UNKNOWN_S=86400
# TTL_PROVIDER_ERROR_S: 10-86400 (default 600 = 10 min backoff)
TTL_PROVIDER_ERROR_S=600
# TTL_UNCERTAIN_S: 60-604800 (default 3600 = 60 min suppression after a provider timeout)
TTL_UNCERTAIN_S=3600
# LEASE_MS: 500-60000 (default 6000); must exceed ENRICH_TIMEOUT_MS
LEASE_MS=6000
# PENDING_WAIT_MS: 0-10000 (default 1500); how long a caller waits on an in-flight lookup
PENDING_WAIT_MS=1500
# PENDING_POLL_MS: 10-1000 (default 75)
PENDING_POLL_MS=75
# CACHE_PRUNE_INTERVAL_S: 30-86400 (default 600)
CACHE_PRUNE_INTERVAL_S=600
# CACHE_PRUNE_BATCH: 10-100000 (default 1000); rows deleted per prune pass
CACHE_PRUNE_BATCH=1000
# OBSERVATION_RETENTION_DAYS: 0-3650 (default 0 = keep); V1 treats this as a bounded sync buffer: the default and upper bound are being revised (owner decision D3, CHR-62); companies and scope stats are never pruned
OBSERVATION_RETENTION_DAYS=0

# ---- Qualification policy (comma-separated; whitespace is trimmed) ----------
# QUALIFIED_USAGE_TYPES: default COM,ORG,GOV,EDU,MIL,LIB
QUALIFIED_USAGE_TYPES=COM,ORG,GOV,EDU,MIL,LIB
# EXCLUDED_USAGE_TYPES: default ISP,MOB,DCH,CDN,SES,RSV
EXCLUDED_USAGE_TYPES=ISP,MOB,DCH,CDN,SES,RSV
# DENIED_DOMAINS: default empty (leave the line out or set it to domains that always resolve to unknown)
DENIED_DOMAINS=

# ---- Migrations ---------------------------------------------------------------
# V1 runs migrations ONLY as a deploy pre-step (railway.json preDeployCommand:
# `node dist/db/migrate.js`) or locally with `npm run migrate`.
# RUN_MIGRATIONS_ON_START: default false; leave unset. (Removed entirely by CHR-70.)
